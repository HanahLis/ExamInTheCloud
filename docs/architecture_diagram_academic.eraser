// ==============================================================================
// CLOUDEXAM – HÌNH 2.3: SƠ ĐỒ KIẾN TRÚC SOẠN ĐỀ BẰNG AI, CỤM 3 LAMBDA SERVERLESS VÀ CSDL DYNAMODB
// Phiên bản chuẩn hóa v4.1 – Bám sát Chapter 1 & Codebase (Gemini + Regex Fallback, S3 Presign, Step Functions, DynamoDB 5 Bảng)
// Cú pháp: Eraser.io Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

// ------------------------------------------------------------------------------
// CỘT 1: GIAO DIỆN & XÁC THỰC NGƯỜI DÙNG (INSTRUCTOR PORTAL)
// ------------------------------------------------------------------------------
"1. GIAO DIỆN & XÁC THỰC" [color: blue] {
  Instructor [icon: users, label: "CloudExam Instructors / Admins\n(Biên soạn đề · Quản lý kỳ thi · Xuất báo cáo)"]
  OrganizerPortal [icon: react, label: "CloudExam Organizer Portal\n(React 19 SPA · Quản trị ngân hàng đề & ca thi)"]
  AuthServer [icon: aws-cognito, label: "CloudExam Auth Server\n(Amazon Cognito User Pool PKCE / JWT)"]
}

// ------------------------------------------------------------------------------
// CỘT 2: CỔNG API & CỤM MODULE XỬ LÝ SERVERLESS (SERVERLESS SERVICES)
// ------------------------------------------------------------------------------
"2. CỔNG API & MODULE SERVERLESS" [color: amber] {
  APIGateway [icon: aws-api-gateway, label: "CloudExam Central API Gateway\n(Amazon API Gateway REST API · Cognito Authorizer)"]
  
  "Cụm xử lý nghiệp vụ Serverless (Graviton2 ARM64)" {
    MediaPresignService [icon: aws-lambda, label: "CloudExam Media Presign Service\n(api_handler.py · S3 Presigned URL Sinh ảnh đề thi)"]
    AIQuestionParser [icon: aws-lambda, label: "CloudExam AI Question Parser\n(api_handler.py · Gemini 1.5 Flash + Regex NLP 0.05s)"]
    AcademicCRUDController [icon: aws-lambda, label: "CloudExam Academic CRUD Controller\n(api_handler.py · Cascade Delete & Session Manager)"]
  }

  SecretsVault [icon: aws-systems-manager, label: "CloudExam Secrets Store\n(AWS SSM Parameter Store: /cloudexam/gemini/api_key)"]
}

// ------------------------------------------------------------------------------
// CỘT 3: LƯU TRỮ ĐA PHƯƠNG TIỆN, CSDL DYNAMODB & ĐIỀU PHỐI VÒNG ĐỜI
// ------------------------------------------------------------------------------
"3. LƯU TRỮ, CSDL DYNAMODB & ĐIỀU PHỐI" [color: green] {
  MediaBucket [icon: aws-s3, label: "CloudExam Media Storage Bucket\n(Amazon S3 · questions/* & faces/*)"]
  
  "Hệ CSDL NoSQL Amazon DynamoDB (On-Demand Capacity)" {
    QuestionBanksTable [icon: aws-dynamodb, label: "CloudExam Question Banks Store\n(DynamoDB: CloudExam_QuestionBanks_dev)"]
    QuestionsTable [icon: aws-dynamodb, label: "CloudExam Questions Store\n(DynamoDB: CloudExam_Questions_dev | GSI: BankIdIndex)"]
    CandidatesTable [icon: aws-dynamodb, label: "CloudExam Candidates Store\n(DynamoDB: CloudExam_Candidates_dev | GSI: StudentCodeIndex)"]
    SessionsTable [icon: aws-dynamodb, label: "CloudExam Sessions Store\n(DynamoDB: CloudExam_Sessions_dev | Room Passcode 6 số)"]
    SubmissionsTable [icon: aws-dynamodb, label: "CloudExam Submissions Store\n(DynamoDB: CloudExam_Submissions_dev | Sparse GSI: SessionResultsIndex)"]
  }

  GenAIEngine [icon: google-cloud, label: "CloudExam External AI Service\n(Google Gemini 1.5 Flash API · Structured Output)"]
  ExamStateMachine [icon: aws-step-functions, label: "CloudExam Exam State Machine\n(AWS Step Functions · Native Wait State $0 Compute)"]
  SNSReporting [icon: aws-sns, label: "CloudExam Alert & Reporting Topic\n(Amazon SNS · Gửi email tổng kết ca thi)"]
}

// ==============================================================================
// LUỒNG TƯƠNG TÁC TÍNH NĂNG VỚI PROTOCOL CHUẨN XÁC & MÃ [L-xx] ĐẦY ĐỦ
// ==============================================================================

// 1. Xác thực và điều hướng API quản trị
Instructor > OrganizerPortal: "Biên soạn câu hỏi / Tải file đề / Thiết lập ca thi"
OrganizerPortal <> AuthServer: "[L-03] HTTPS POST (OAuth 2.0 PKCE / Bearer JWT Claims)"
OrganizerPortal > APIGateway: "[L-04] HTTPS REST (Port 443 + Bearer JWT + Tenant Header)"

// 2. Tải ảnh câu hỏi trực tiếp (Presign Direct Upload Pattern)
APIGateway > MediaPresignService: "[L-05a] AWS Lambda Proxy Integration (POST /questions/presign)"
MediaPresignService > MediaBucket: "[L-06] AWS SDK Boto3 (SigV4) - Action: s3:generate_presigned_url (questions/ TTL 300s)"
OrganizerPortal > MediaBucket: "[L-07] Direct HTTPS PUT ảnh câu hỏi (0MB qua backend)"

// 3. Số hóa đề thi tự động bằng GenAI Gemini & Regex NLP Fallback
APIGateway > AIQuestionParser: "[L-05b] AWS Lambda Proxy Integration (POST /questions/parse-doc)"
AIQuestionParser > SecretsVault: "[L-08] AWS SDK Boto3 (SigV4) - Action: ssm:GetParameter (/cloudexam/gemini/api_key)"
AIQuestionParser > GenAIEngine: "[L-09] REST over HTTPS (POST /v1beta/models/gemini-1.5-flash:generateContent)"
GenAIEngine > AIQuestionParser: "[L-10] HTTPS Response 200 (Structured JSON MCQs [A,B,C,D])"
AIQuestionParser > AIQuestionParser: "Fallback Engine: Regex NLP Parser (Khởi động trong 0.05s nếu AI timeout/lỗi)"
AIQuestionParser > QuestionsTable: "[L-11b] AWS SDK Boto3 (SigV4) - Action: dynamodb:BatchWriteItem (CloudExam_Questions_dev)"

// 4. CRUD Ngân hàng đề, Thí sinh & Tạo ca thi kèm Passcode 6 số
APIGateway > AcademicCRUDController: "[L-05c] AWS Lambda Proxy Integration (/banks, /candidates, /sessions)"
AcademicCRUDController > QuestionBanksTable: "[L-11a] AWS SDK Boto3 (SigV4) - Action: dynamodb:PutItem (QuestionBanks)"
AcademicCRUDController > CandidatesTable: "[L-11c] AWS SDK Boto3 (SigV4) - Action: dynamodb:BatchWriteItem (Candidates)"
AcademicCRUDController > SessionsTable: "[L-11d] AWS SDK Boto3 (SigV4) - Action: dynamodb:PutItem (Sessions: SCHEDULED, roomPassword)"
AcademicCRUDController > SubmissionsTable: "Cascade Delete & Cleanup Submissions khi xóa ca thi"

// 5. Điều phối vòng đời ca thi tự động qua AWS Step Functions
AcademicCRUDController > ExamStateMachine: "[L-11e] AWS SDK Boto3 (SigV4) - Action: states:StartExecution (sessionId)"
ExamStateMachine > SessionsTable: "Native Wait State: Cập nhật SCHEDULED -> RUNNING -> CLOSED ($0 Compute)"
ExamStateMachine > AcademicCRUDController: "AutoFinalizeTask: Quét và cứu toàn bộ bài làm nháp của thí sinh mất mạng"
ExamStateMachine > SNSReporting: "states:Task - Action: sns:Publish (Gửi email báo cáo ca thi hoàn tất)"
AcademicCRUDController > OrganizerPortal: "HTTP 200 OK (Số hóa đề & lập lịch ca thi thành công 100%)"
