// ==============================================================================
// BIỂU ĐỒ 6: QUẢN TRỊ DEVOPS, GIÁM SÁT & FINOPS (0 USD CLOUD)
// HashiCorp Terraform IaC, CloudWatch Alarms, AWS Budgets (0.50$) & SNS Alerts
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

IaCGovernance [label: "1. QUẢN TRỊ HẠ TẦNG DẠNG MÃ (IaC)", color: purple] {
  Terraform [icon: terraform, label: "HashiCorp Terraform (14 Modules)\nQuản trị hạ tầng tự động hóa 100%\nCost Allocation Tags: Project=CloudExam, CostCenter=FinOps-0USD"]
  IAMRoles [icon: aws-iam, label: "AWS IAM Roles (Least-Privilege)\nTách role Core API, Face Verify, Grading Worker\nChặn tuyệt đối quyền xóa DDL"]
}

CloudWatchSuite [label: "2. GIÁM SÁT TẬP TRUNG (AMAZON CLOUDWATCH)", color: blue] {
  CWLogs [icon: aws-cloudwatch, label: "CloudWatch Log Groups (3 Groups)\nGiới hạn cứng Retention 14 ngày (FinOps 0$)"]
  MetricFilters [icon: aws-cloudwatch, label: "Metric Filters JSON cấu trúc\nFaceVerificationFailures & FaceVerificationSuccess"]
  MetricAlarms [icon: aws-cloudwatch, label: "4 Metric Alarms Tự Động:\n• API 5XX Errors (>= 1)\n• Lambda Face Errors (>= 3)\n• Lambda Core Errors (>= 3)\n• SQS DLQ Messages (> 0)"]
  XRay [icon: aws-x-ray, label: "AWS X-Ray Distributed Tracing\nTraceId gắn xuyên suốt HTTP Header (P99 Latency)"]
}

FinOpsGuardrails [label: "3. HÀNG RÀO BẢO VỆ CHI PHÍ (FINOPS 0$)", color: green] {
  AWSBudgets [icon: aws-cloudwatch, label: "AWS Budgets (cloudexam-monthly-budget-dev)\nHạn mức cảnh báo: 0.50 USD / tháng\n3 Lớp cảnh báo: 80% (0.40$), 100% (0.50$), Forecasted"]
  S3Lifecycle [icon: aws-s3, label: "S3 Lifecycle Rules\nTự động xóa ảnh tạm temp/ sau 24h\nHủy Multipart Uploads dở dang sau 1 ngày"]
}

AlertsNotification [label: "4. KÊNH THÔNG BÁO KHẨN CẤP (ALERTING)", color: orange] {
  SNSTopic [icon: aws-sns, label: "Amazon SNS Topic (cloudexam-alerts-dev)\nKênh điều phối thông báo tập trung"]
  Admins [icon: users, label: "Ban Quản Trị & Kỹ Sư Vận Hành\nEmail & SMS cảnh báo thời gian thực"]
}

// Kết nối luồng
Terraform > IAMRoles: "1. Khởi tạo Roles & Policies an toàn"
CWLogs > MetricFilters: "2. Bóc tách chỉ số từ log sự kiện"
MetricFilters > MetricAlarms: "3. Theo dõi ngưỡng vượt chỉ tiêu"
MetricAlarms > SNSTopic: "4. Kích hoạt cảnh báo sự cố"
AWSBudgets > SNSTopic: "5. Bắn cảnh báo ngân sách 0.50$"
SNSTopic > Admins: "6. Gửi Email / SMS khẩn cấp tới Ban quản trị"

