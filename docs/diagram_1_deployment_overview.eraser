// BIỂU ĐỒ 1: KIẾN TRÚC TRIỂN KHAI TỔNG THỂ (HIGH-LEVEL DEPLOYMENT OVERVIEW)
// Mô hình Hạt nhân & Vệ tinh (Hub-and-Spoke Multi-Cloud) & Đa vùng DR
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

Users [icon: users, label: "Người Dùng (Việt Nam & Lào)"]

EdgeCloud [label: "1. BẢO MẬT BIÊN & CDN TOÀN CẦU", color: blue] {
  Cloudflare [icon: cloudflare, label: "Cloudflare Turnstile (Anti-Bot)"]
  Route53 [icon: aws-route-53, label: "Amazon Route 53 (DNS & Failover)"]
  CloudFront [icon: aws-cloudfront, label: "CloudFront CDN & AWS WAFv2"]
}

AWSSingapore [label: "2. AWS PRIMARY REGION (Singapore - ap-southeast-1)", color: amber] {
  APIGateway [icon: aws-api-gateway, label: "Amazon API Gateway (REST API)"]
  Cognito [icon: aws-cognito, label: "Cognito User Pool (PKCE Auth)"]
  LambdaHub [icon: aws-lambda, label: "Lambda Functions (Core, Face, Grading)"]
  SQSPipeline [icon: aws-sqs, label: "Amazon SQS & Dead Letter Queue"]
  DynamoDBSingapore [icon: aws-dynamodb, label: "DynamoDB (Multi-Tenant Data)"]
  S3Singapore [icon: aws-s3, label: "Amazon S3 Media Storage"]
}

MultiCloud [label: "3. VỆ TINH ĐA ĐÁM MÂY (MULTI-CLOUD SATELLITES)", color: cyan] {
  GoogleGemini [icon: google-cloud, label: "Google Cloud Gemini 1.5 Flash (0$)"]
  UpstashRedis [icon: redis, label: "Upstash Serverless Redis (< 5ms)"]
}

AWSJakarta [label: "4. AWS DR REPLICA REGION (Jakarta - ap-southeast-3)", color: green] {
  DynamoDBJakarta [icon: aws-dynamodb, label: "DynamoDB Global Tables Replica"]
  S3Jakarta [icon: aws-s3, label: "S3 Cross-Region Replica (CRR)"]
}

FinOpsOps [label: "5. QUẢN TRỊ FINOPS & GIÁM SÁT", color: purple] {
  TerraformIaC [icon: terraform, label: "HashiCorp Terraform (IaC)"]
  CloudWatchSNS [icon: aws-cloudwatch, label: "CloudWatch, Budgets (0.50$) & SNS"]
}

// Kết nối luồng chính
Users > EdgeCloud: "HTTPS cloudexam.vn / edulao.la"
EdgeCloud > AWSSingapore: "Định tuyến REST & Phân phối Web"
AWSSingapore > MultiCloud: "Bóc tách đề Word & Live Leaderboard"
AWSSingapore > AWSJakarta: "Đồng bộ Global Tables & S3 CRR (RPO < 1s)"
Route53 --> AWSJakarta: "DNS Failover khi Singapore sự cố (RTO < 2m)"
TerraformIaC > AWSSingapore: "Tự động hóa 100% hạ tầng"
AWSSingapore > CloudWatchSNS: "Logs, Metrics & Cảnh báo chi phí"

