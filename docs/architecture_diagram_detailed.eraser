// ==============================================================================
// HỆ THỐNG CLOUDEXAM - SƠ ĐỒ KIẾN TRÚC CHỨC NĂNG CHI TIẾT (ENTERPRISE / ACADEMIC SPEC)
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// Dự án: CloudExam - Nền tảng khảo thí trực tuyến Serverless & AI Đa Quốc Gia
// Nhóm thực hiện: Nhóm 14 - INT3319 1 (Điện toán đám mây - VNU-UET)
// ==============================================================================
// QUY TẮC ĐỊNH DANH & GIAO THỨC TRUYỀN THÔNG:
// 1. Không sử dụng tên chung chung (không ghi 'EC2', 'S3' đơn độc). Mỗi thành phần
//    đều có tên chức năng nghiệp vụ cụ thể kèm dịch vụ đám mây tương ứng trong ngoặc.
// 2. Mọi đường kết nối (Edge) đều có nhãn giao thức (Protocol), phương thức (HTTP Method),
//    loại định dạng dữ liệu (Payload format) và thời gian hiệu lực (TTL nếu có).
// 3. Toàn bộ mã nguồn sơ đồ dưới đây có thể copy & paste trực tiếp vào app.eraser.io.
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. VÙNG TRUY CẬP NGƯỜI DÙNG & BIÊN PHÒNG THỦ (CLIENT & EDGE SECURITY ZONE)
// ------------------------------------------------------------------------------
"1. CLIENT & EDGE SECURITY ZONE" [color: blue] {
  Users [icon: users, label: "CloudExam Multi-Country Users\n(Thí sinh & Giảng viên Đa quốc gia: VN, Lào, Quốc tế)"]
  Turnstile [icon: shield, label: "CloudExam Edge Anti-Bot & Fraud Shield\n(Cloudflare Turnstile Invisible CAPTCHA < 0.1s)"]
  Route53 [icon: aws-route-53, label: "CloudExam Global DNS & Latency Routing\n(Amazon Route 53 — Tên miền cloudexam.vn & edulao.la)"]
  CloudFront [icon: aws-cloudfront, label: "CloudExam Edge Content Delivery & Tenant Router\n(Amazon CloudFront CDN & CloudFront Functions)"]
  ReactSPA [icon: react, label: "CloudExam Single Page Application Client\n(React 18 + Vite + Tailwind CSS Dynamic UI Engine)"]
  Webcam [icon: camera, label: "CloudExam HTML5 Media Capture Hardware Layer\n(Webcam MediaDevices API & Base64 Canvas Capture)"]
}

// ------------------------------------------------------------------------------
// 2. VÙNG BẢO MẬT ĐỊNH DANH & CỔNG TIẾP NHẬN (IDENTITY & API GATEWAY ZONE)
// ------------------------------------------------------------------------------
"2. IDENTITY & API GATEWAY ZONE" [color: cyan] {
  Cognito [icon: aws-cognito, label: "CloudExam Central Identity Provider\n(Amazon Cognito User Pool — OAuth 2.0 Authorization Code PKCE)"]
  APIGateway [icon: aws-api-gateway, label: "CloudExam Central REST API Gateway\n(Amazon API Gateway — Regional REST & Cognito JWT Authorizer)"]
  IAMRoles [icon: aws-iam, label: "CloudExam Least-Privilege IAM Controller\n(AWS Identity & Access Management Execution Roles)"]
}

// ------------------------------------------------------------------------------
// 3. VÙNG TÍNH TOÁN SERVERLESS & TRÍ TUỆ NHÂN TẠO (SERVERLESS COMPUTE & AI ENGINE)
// ------------------------------------------------------------------------------
"3. SERVERLESS COMPUTE & AI ENGINE" [color: amber] {
  LambdaCore [icon: aws-lambda, label: "CloudExam Core Business Application Server\n(AWS Lambda Python 3.11 — api_handler.py | 256MB, Timeout 30s)"]
  LambdaFace [icon: aws-lambda, label: "CloudExam Biometric Verification Server\n(AWS Lambda Python 3.11 — face_verify_handler.py | 512MB RAM)"]
  Rekognition [icon: aws-rekognition, label: "CloudExam AI Biometric Computer Vision Engine\n(Amazon Rekognition CompareFaces SaaS — Similarity >= 80.0%)"]
  StepFunctions [icon: aws-step-functions, label: "CloudExam Exam Lifecycle State Machine\n(AWS Step Functions & EventBridge Scheduler)"]
  LambdaGrading [icon: aws-lambda, label: "CloudExam Asynchronous Auto-Grading Worker\n(AWS Lambda Python 3.11 — grading_worker.py | BatchSize 10)"]
  SNSDispatcher [icon: aws-sns, label: "CloudExam Automated Exam Results Dispatcher\n(Amazon SNS Topic: CloudExam_ExamResults_Topic)"]
}

// ------------------------------------------------------------------------------
// 4. VÙNG HÀNG ĐỢI, CSDL NOSQL & LƯU TRỮ ĐA VÙNG (PERSISTENCE & BUFFER PIPELINE)
// ------------------------------------------------------------------------------
"4. PERSISTENCE & BUFFER PIPELINE" [color: green] {
  SQSQueue [icon: aws-sqs, label: "CloudExam Distributed Exam Submissions Queue\n(Amazon SQS Standard Buffer Queue — Retention 4d, Visibility 180s)"]
  SQSDLQ [icon: aws-sqs, label: "CloudExam Submissions Dead-Letter Queue (DLQ)\n(Amazon SQS DLQ — Redrive Policy maxReceiveCount = 3)"]
  S3MediaPrimary [icon: aws-s3, label: "CloudExam Media & Biometric Storage Bucket\n(Amazon S3 Primary Bucket: cloudexam-storage-409289618109-dev)"]
  DynamoDBPrimary [icon: aws-dynamodb, label: "CloudExam High-Speed NoSQL Datastore Cluster\n(Amazon DynamoDB 4 Tables On-Demand — Single-digit ms Latency)"]
  DynamoDBReplica [icon: aws-dynamodb, label: "CloudExam Disaster Recovery Replica Datastore\n(Amazon DynamoDB Global Tables — ap-southeast-3 Jakarta, RPO < 1s)"]
  S3MediaReplica [icon: aws-s3, label: "CloudExam Disaster Recovery Storage Replica\n(Amazon S3 Cross-Region Replication — ap-southeast-3 Jakarta)"]
}

// ------------------------------------------------------------------------------
// 5. CÁC VỆ TINH ĐA ĐÁM MÂY (EXTERNAL MULTI-CLOUD SATELLITES - $0 TIER)
// ------------------------------------------------------------------------------
"5. MULTI-CLOUD SATELLITES ($0 TIER)" [color: orange] {
  GoogleGemini [icon: cloud, label: "CloudExam Generative AI Examination Intelligence\n(Google Gemini 1.5 Flash API — AI Studio Free Tier 15 RPM)"]
  UpstashRedis [icon: database, label: "CloudExam Real-Time Live Leaderboard Engine\n(Upstash Serverless Redis In-Memory Cloud — Latency < 5ms)"]
}

// ------------------------------------------------------------------------------
// 6. QUẢN TRỊ VẬN HÀNH, GIÁM SÁT & FINOPS (OBSERVABILITY & FINOPS GOVERNANCE)
// ------------------------------------------------------------------------------
"6. OBSERVABILITY & FINOPS GOVERNANCE" [color: purple] {
  CloudWatch [icon: aws-cloudwatch, label: "CloudExam Central Telemetry & Monitoring Engine\n(Amazon CloudWatch Logs, Metrics & CloudWatch Alarms)"]
  Budgets [icon: aws-cloudwatch, label: "CloudExam FinOps Zero-Cost Budget Guard\n(AWS Budgets & Cost Anomaly Detection — Ngưỡng 0.50 USD)"]
  Terraform [icon: terraform, label: "CloudExam Infrastructure as Code Orchestrator\n(HashiCorp Terraform — 14 Modules HCL Automating 100% Infra)"]
}

// ==============================================================================
// GIAO THỨC TRUYỀN THÔNG & ĐƯỜNG KẾT NỐI NGHIỆP VỤ (CONNECTORS & PROTOCOLS)
// ==============================================================================

// [LUỒNG 1] Phân phối nội dung biên, Định tuyến tên miền & Chống Bot
Users > Route53: "1. HTTPS / TLS 1.3 (DNS Query: cloudexam.vn / edulao.la)"
Route53 > CloudFront: "2. DNS Anycast Latency-based Routing"
Users > Turnstile: "3. HTTPS Challenge Token (< 0.1s Turnstile Widget)"
CloudFront > ReactSPA: "4. HTTPS GET / Phân phối Static Assets Caching (< 20ms Edge)"
Webcam > ReactSPA: "5. HTML5 MediaDevices / Base64 Frame Capture (Camera sinh viên)"

// [LUỒNG 2] Xác thực Danh tính Tập trung OAuth 2.0 PKCE & Cổng REST API
ReactSPA > Cognito: "6. HTTPS POST / OAuth 2.0 Authorization Code (PKCE Hosted UI)"
Cognito > ReactSPA: "7. OIDC Bearer Tokens (ID Token & Access Token JWT)"
Cognito > APIGateway: "8. HTTPS JWKS RSA256 / Xác thực chữ ký số JWT tự động"
ReactSPA > APIGateway: "9. HTTPS REST API / Header Authorization: Bearer <ID_TOKEN> & x-tenant-id"

// [LUỒNG 3] Nghiệp vụ Điểm danh Sinh trắc học AI (Anti-Cheat 1:1 Face Match)
APIGateway > LambdaFace: "10. HTTPS POST /auth/face-verify (Payload: sessionId, email, capturedImage b64)"
LambdaFace > S3MediaPrimary: "11. AWS SDK (Boto3) s3:GetObject / Tải ảnh thẻ gốc (faces/{studentCode}.jpg)"
LambdaFace > Rekognition: "12. AWS SDK (Boto3) compare_faces / SourceImage (S3) vs TargetImage (Webcam)"
Rekognition > LambdaFace: "13. Boto3 Response / Vector Match (SimilarityThreshold >= 80.0%)"
LambdaFace > DynamoDBPrimary: "14. AWS SDK (Boto3) update_item / Ghi nhận trạng thái: CHECKED_IN"

// [LUỒNG 4] Quản trị Khảo thí & Mẫu hình S3 Direct Upload (0% Server Load)
APIGateway > LambdaCore: "15. AWS Lambda Proxy Integration / CRUD Đề thi, Ngân hàng câu hỏi, Thí sinh, Ca thi"
LambdaCore > S3MediaPrimary: "16. AWS SDK s3:generate_presigned_url / PUT Action (Presigned URL TTL 300s)"
ReactSPA > S3MediaPrimary: "17. Direct HTTPS PUT (Presigned URL) / Tải ảnh trực tiếp lên S3 questions/* (0% Server Load)"
LambdaCore > DynamoDBPrimary: "18. AWS SDK (Boto3) CRUD / Bản ghi Questions, Banks, Sessions, Candidates"

// [LUỒNG 5] Số hóa Đề thi Tự động qua Google Gemini 1.5 Flash AI
LambdaCore > GoogleGemini: "19. HTTPS REST API (generateContent) / Gửi Text thô từ file Word (.docx) / PDF"
GoogleGemini > LambdaCore: "20. JSON Array Payload / Bóc tách [A, B, C, D, Đáp án đúng, Độ khó Dễ/TB/Khó]"

// [LUỒNG 6] Nộp bài Bất đồng bộ qua Hàng đợi Amazon SQS & Chống nghẽn tải
ReactSPA > APIGateway: "21. HTTPS POST /exam/submit (Payload: Candidate Answers + Turnstile Token)"
APIGateway > LambdaCore: "22. Lambda Proxy Integration / Tiếp nhận yêu cầu nộp bài"
LambdaCore > SQSQueue: "23. AWS SDK (Boto3) sqs:SendMessage / Enqueue bài nộp vào Buffer (< 50ms ACK)"
LambdaCore > ReactSPA: "24. HTTP 200 OK / Phản hồi nộp bài an toàn lập tức cho thí sinh"
SQSQueue > LambdaGrading: "25. AWS Lambda Event Source Mapping / Tiêu thụ thông điệp theo lô (BatchSize = 10)"
SQSQueue > SQSDLQ: "26. SQS Redrive Policy / Chuyển bài lỗi vào DLQ sau 3 lần retry thất bại"

// [LUỒNG 7] Chấm điểm Tự động & Bảng xếp hạng Real-time Upstash Redis
LambdaGrading > DynamoDBPrimary: "27. AWS SDK (Boto3) update_item / Đối soát đáp án, Lưu điểm & COMPLETED"
LambdaGrading > UpstashRedis: "28. RESP over TLS (TCP 6379) / ZADD Cập nhật điểm Real-time Leaderboard (< 5ms)"
ReactSPA > APIGateway: "29. HTTPS GET /sessions/{id}/leaderboard / Thí sinh & Giảng viên xem Top 5"
APIGateway > LambdaCore: "30. Lambda Proxy Route / Điều phối yêu cầu bảng xếp hạng"
LambdaCore > UpstashRedis: "31. RESP over TLS (TCP 6379) / ZREVRANGE Lấy Top 5 điểm cao nhất (< 5ms Latency)"

// [LUỒNG 8] Tự động hóa Chu trình Ca thi & Phát hành Báo cáo Điểm qua Amazon SNS
StepFunctions > DynamoDBPrimary: "32. AWS SDK DynamoDB / Quản lý trạng thái: SCHEDULED -> RUNNING -> CLOSED"
StepFunctions > SNSDispatcher: "33. AWS SDK (Boto3) sns:Publish / Kích hoạt phát email bảng điểm ca thi cho Giảng viên"

// [LUỒNG 9] Sao lưu Đa Vùng Phục hồi Thảm họa (Zero-ClickOps Multi-Region DR)
DynamoDBPrimary <> DynamoDBReplica: "34. DynamoDB Global Tables / Đồng bộ 2 chiều Singapore <-> Jakarta (RPO < 1s)"
S3MediaPrimary > S3MediaReplica: "35. Amazon S3 Cross-Region Replication (CRR) / Tự động nhân bản bất đồng bộ"
Route53 .> DynamoDBReplica: "36. DNS Health Check & Automated Failover / Chuyển hướng sang Jakarta khi DR"

// [LUỒNG 10] Quản trị Vận hành, Giám sát Tập trung & FinOps 0 USD Tier
LambdaCore > CloudWatch: "37. CloudWatch Embedded Metric Format / Structured JSON Logs & P99 Latency Tracing"
LambdaFace > CloudWatch: "38. CloudWatch Logs / Ghi nhận độ tương đồng sinh trắc học & Tỷ lệ Check-in"
LambdaGrading > CloudWatch: "39. CloudWatch Logs / Đo lường thông lượng chấm điểm & Độ trễ Worker"
CloudWatch > Budgets: "40. CloudWatch Alarms / Kích hoạt cảnh báo khi cước chạm ngưỡng 0.50 USD"
Terraform > IAMRoles: "41. HashiCorp Terraform IaC / Tự động khởi tạo và gán quyền Least-Privilege Execution Roles"

