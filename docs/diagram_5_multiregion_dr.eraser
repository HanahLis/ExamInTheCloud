// ==============================================================================
// BIỂU ĐỒ 5: PHỤC HỒI THẢM HỌA ĐA VÙNG (ZERO-CLICKOPS MULTI-REGION DR)
// Singapore (ap-southeast-1) <-> Jakarta (ap-southeast-3), Route 53 DNS Failover
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

Route53DNS [icon: aws-route-53, label: "Amazon Route 53 DNS\nFailover Routing Policy\nHealth Check Endpoint /health (10s)"]

PrimarySingapore [label: "1. VÙNG HOẠT ĐỘNG CHÍNH (Singapore - ap-southeast-1)", color: amber] {
  APISingapore [icon: aws-api-gateway, label: "API Gateway (Primary REST API)"]
  DynamoDBSingapore [icon: aws-dynamodb, label: "DynamoDB Primary Tables\nBilling: PAY_PER_REQUEST ($0 idle)"]
  S3Singapore [icon: aws-s3, label: "Amazon S3 Primary Bucket\nẢnh thẻ faces/ & Ảnh đề questions/"]
  KMSSingapore [icon: aws-kms, label: "KMS Primary CMK (mrk-xxxxxxxx)"]
}

ReplicaJakarta [label: "2. VÙNG DỰ PHÒNG THẢM HỌA (Jakarta - ap-southeast-3)", color: green] {
  APIJakarta [icon: aws-api-gateway, label: "API Gateway (Standby DR REST API)"]
  DynamoDBJakarta [icon: aws-dynamodb, label: "DynamoDB Global Tables Replica\nĐồng bộ 2 chiều Active-Passive (RPO < 1s)"]
  S3Jakarta [icon: aws-s3, label: "Amazon S3 Replica Bucket\nCross-Region Replication (CRR)"]
  KMSJakarta [icon: aws-kms, label: "KMS Replica CMK (mrk-xxxxxxxx)"]
}

// Luồng định tuyến & Đồng bộ dữ liệu
Route53DNS > APISingapore: "1. Định tuyến HTTPS bình thường (Primary)"
Route53DNS -- APISingapore: "2. Health Check thăm dò mỗi 10 giây"

// Luồng nhân bản chéo vùng tự động của AWS
DynamoDBSingapore <> DynamoDBJakarta: "3. Global Tables Replication 2 chiều (RPO < 1s)"
S3Singapore > S3Jakarta: "4. S3 Cross-Region Replication (CRR)"
KMSSingapore <> KMSJakarta: "5. Multi-Region Key Sync (DEK Re-encryption)"

// Luồng chuyển vùng tự động khi xảy ra thảm họa
Route53DNS --> APIJakarta: "6. Zero-ClickOps DNS Failover sang Jakarta (RTO < 2 phút)"

