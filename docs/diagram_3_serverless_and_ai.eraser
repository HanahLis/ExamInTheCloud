// ==============================================================================
// BIỂU ĐỒ 3: XỬ LÝ SERVERLESS & TRÍ TUỆ NHÂN TẠO (AI HUB)
// Core API, Điểm danh Rekognition, Bóc tách đề Gemini AI & Step Functions
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

APIGateway [icon: aws-api-gateway, label: "Amazon API Gateway\nREST API Routes"]

ServerlessCompute [label: "1. XỬ LÝ SERVERLESS (AWS LAMBDA)", color: amber] {
  LambdaCore [icon: aws-lambda, label: "Lambda Core API (api_handler.py)\nPython 3.11 • 256MB RAM\nCRUD Đề, Thí sinh, Ca thi & Presigned URL"]
  LambdaFace [icon: aws-lambda, label: "Lambda Face Verify (face_verify_handler.py)\nPython 3.11 • 512MB RAM\nDecode Base64 ảnh camera webcam"]
  StepFunctions [icon: aws-step-functions, label: "AWS Step Functions State Machine\nĐiều phối chu kỳ ca thi: SCHEDULED -> RUNNING -> CLOSED"]
}

AIIntelligence [label: "2. TRÍ TUỆ NHÂN TẠO (AI & VISION)", color: cyan] {
  Rekognition [icon: aws-rekognition, label: "Amazon Rekognition\nCompareFaces API (Độ tương đồng >= 80%)\nSo khớp vector sinh trắc học"]
  GoogleGemini [icon: google-cloud, label: "Google Cloud Gemini 1.5 Flash\nFree 1,500 req/ngày (0.00$ AI Studio)\nBóc tách file Word đề sang JSON & AI Gia sư"]
}

DataPersistence [label: "3. LƯU TRỮ DỮ LIỆU & MEDIA (STORAGE)", color: green] {
  DynamoDB [icon: aws-dynamodb, label: "Amazon DynamoDB (4 Bảng NoSQL)\nCloudExam_{Questions, Candidates, Sessions, Banks}\nPartition Key Prefix: TENANT#VN# & TENANT#LA#"]
  S3Media [icon: aws-s3, label: "Amazon S3 Media Bucket\nfaces/ (Ảnh thẻ gốc) & questions/ (Ảnh đề)\nLifecycle Rule: Xóa ảnh temp/ sau 24h"]
}

// Kết nối luồng
APIGateway > LambdaCore: "1. Proxy CRUD Đề & Ca thi"
APIGateway > LambdaFace: "2. Proxy ảnh Webcam (/auth/face-verify)"

LambdaFace > S3Media: "3. Đọc ảnh thẻ gốc (faces/{studentCode}.jpg)"
LambdaFace > Rekognition: "4. So khớp khuôn mặt (Source vs Target)"
Rekognition > LambdaFace: "5. Kết quả khớp (PASS >= 80% / FAIL)"
LambdaFace > DynamoDB: "6. Ghi nhận check-in vào Session"

LambdaCore > GoogleGemini: "7. Kéo thả file Word -> Gemini bóc tách JSON (0$)"
LambdaCore > S3Media: "8. Sinh S3 Presigned URL (TTL 300s)"
LambdaCore > DynamoDB: "9. Lưu Ngân hàng câu hỏi & Metadata"
StepFunctions > DynamoDB: "10. Cập nhật Status ca thi (Zero-Compute)"

