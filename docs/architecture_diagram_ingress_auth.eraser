// ==============================================================================
// CLOUDEXAM – HÌNH 2.2: PHÂN HỆ CỔNG BIÊN, ĐA THUÊ BẠ VÀ AN NINH CỔNG API
// Phiên bản chuẩn hóa v4.1 – Bám sát Chapter 1 & Codebase (React 19, Cognito PKCE/OTP, WAFv2, CloudFront)
// Cú pháp: Eraser.io Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

// ------------------------------------------------------------------------------
// CỘT 1: TRUY CẬP ĐA QUỐC GIA & ĐỊNH TUYẾN TOÀN CẦU (GLOBAL INGRESS)
// ------------------------------------------------------------------------------
"1. TRUY CẬP & ĐỊNH TUYẾN TOÀN CẦU" [color: blue] {
  VNCandidate [icon: users, label: "CloudExam VN Candidates\n(Domain: vn.cloudexam.id.vn / VI)"]
  LACandidate [icon: users, label: "CloudExam Lao Candidates\n(Domain: lao.cloudexam.id.vn / LA)"]
  GlobalUsers [icon: users, label: "CloudExam Global Candidates\n(Domain: de. / us. / cloudexam.id.vn)"]
  GlobalDNS [icon: aws-route-53, label: "CloudExam Global DNS\n(Amazon Route 53 Geolocation & Latency)"]
}

// ------------------------------------------------------------------------------
// CỘT 2: PHÂN PHỐI NỘI DUNG TẠI BIÊN & ĐA THUÊ BẠ (EDGE MULTI-TENANCY)
// ------------------------------------------------------------------------------
"2. PHÂN PHỐI BIÊN & ĐA THUÊ BẠ" [color: amber] {
  EdgeCDN [icon: aws-cloudfront, label: "CloudExam Edge CDN Distribution\n(Amazon CloudFront Edge Cache < 20ms)"]
  EdgeFunction [icon: aws-lambda, label: "CloudExam Edge Tenant Resolver\n(CloudFront Functions Viewer Request)"]
  SPAStorage [icon: aws-s3, label: "CloudExam Static Web Hosting Bucket\n(Amazon S3 Origin Access Control OAC)"]
  ThemedClient [icon: react, label: "CloudExam Multi-Tenant Web Portal\n(React 19 SPA · 4 Languages VI-LA-DE-EN)"]
}

// ------------------------------------------------------------------------------
// CỘT 3: BẢO VỆ TƯỜNG LỬA, ĐỊNH DANH & CỔNG API (SECURITY & ACCESS CONTROL)
// ------------------------------------------------------------------------------
"3. AN NINH, ĐỊNH DANH & CỔNG API" [color: green] {
  CognitoPool [icon: aws-cognito, label: "CloudExam Central Auth Server\n(Amazon Cognito User Pool · PKCE & In-App OTP)"]
  WAFShield [icon: aws-waf, label: "CloudExam Web Application Firewall\n(AWS WAFv2 Web ACL · Rate Limit 2,000 req/5m)"]
  APIGateway [icon: aws-api-gateway, label: "CloudExam Central API Gateway\n(Amazon API Gateway REST · Cognito Authorizer)"]
  CoreAPIHandler [icon: aws-lambda, label: "CloudExam Core API Server\n(AWS Lambda · api_handler.py | Graviton2 arm64)"]
}

// ==============================================================================
// LUỒNG TƯƠNG TÁC TÍNH NĂNG ĐẦY ĐỦ MÃ ĐỊNH DANH [L-xx] & GIAO THỨC CHUẨN
// ==============================================================================

// 1. Phân giải DNS và định tuyến Edge đa quốc gia
VNCandidate > GlobalDNS: "[L-01a] DNS Query (UDP/TCP 53) - vn.cloudexam.id.vn"
LACandidate > GlobalDNS: "[L-01b] DNS Query (UDP/TCP 53) - lao.cloudexam.id.vn"
GlobalUsers > GlobalDNS: "[L-01c] DNS Query (UDP/TCP 53) - de. / us. / cloudexam.id.vn"
GlobalDNS > EdgeCDN: "[L-01d] Anycast Edge Ingress (HTTPS / TLS 1.3 - Port 443)"

// 2. Multi-tenant Header Injection & Phục vụ Web tĩnh qua S3 OAC
EdgeCDN > EdgeFunction: "[L-02a] CloudFront Viewer Request Hook (Edge Event)"
EdgeFunction > EdgeCDN: "[L-02b] Inject Header: x-tenant-id (vn / lao / de / default)"
EdgeCDN > SPAStorage: "[L-02c] S3 Origin Access Control (OAC) over HTTPS (SigV4)"
EdgeCDN > ThemedClient: "[L-02d] Phục vụ React 19 SPA Assets (Gzip/Brotli Cached < 20ms)"

// 3. Đăng nhập / Đăng ký phân quyền OAuth 2.0 PKCE & In-App OTP Email
ThemedClient <> CognitoPool: "[L-03] HTTPS POST (OAuth 2.0 PKCE / In-App Signup OTP Email)"
CognitoPool > ThemedClient: "Cấp phát Bearer JWT (ID Token & Access Token, TTL 60m)"

// 4. Kiểm soát an ninh tường lửa WAFv2 và xác thực API Gateway
ThemedClient > WAFShield: "[L-04a] HTTPS REST Requests (Port 443 + Bearer JWT + Tenant Header)"
WAFShield > APIGateway: "[L-04b] AWS WAFv2 Web ACL Inspection (Rate Limit & Anti-SQLi/XSS)"
APIGateway > APIGateway: "[L-04c] Built-in Cognito Authorizer (Verify JWT Signature JWKS & Expiry)"
APIGateway > CoreAPIHandler: "[L-05] AWS Lambda Proxy Integration (Payload v1.0, SigV4 IAM)"
