// ==============================================================================
// QUY TRÌNH C: THÍ SINH LÀM BÀI THI TRỰC TUYẾN & ĐỒNG BỘ TRẠNG THÁI CLOUD
// Cú pháp: Eraser.io Diagram-as-Code (Flowchart)
// ==============================================================================

direction down

Start [shape: oval, label: "Bắt đầu làm bài"]
Step1 [shape: rectangle, label: "Bước 1: Tải đề thi qua GET /sessions/{id} (Backend ẩn correctAnswer chống F12)"]
Step2 [shape: rectangle, label: "Bước 2: Kích hoạt đồng hồ đếm ngược & Hiển thị ảnh minh họa từ S3"]
Step3 [shape: rectangle, label: "Bước 3: Thí sinh chọn đáp án trắc nghiệm trên giao diện"]
AtomicSync [shape: rectangle, label: "Đồng bộ tức thì: Atomic Update vào DynamoDB & Lưu LocalStorage"]
CheckNetwork [shape: diamond, label: "Gặp sự cố rớt mạng hoặc mất điện?"]
Recovery [shape: rectangle, label: "Tự động khôi phục 100% các câu đã chọn khi mở lại trình duyệt"]

CheckSubmit [shape: diamond, label: "Hết giờ thi HOẶC Thí sinh bấm 'Nộp bài'?"]
KeepWorking [shape: rectangle, label: "Tiếp tục làm bài và đếm ngược thời gian"]
Step4 [shape: rectangle, label: "Bước 4: Đóng gói toàn bộ câu trả lời, kích hoạt nộp bài"]
End [shape: oval, label: "Chuyển tiếp sang Quy trình D (Nộp & Chấm điểm)"]

Start > Step1
Step1 > Step2
Step2 > Step3
Step3 > AtomicSync
AtomicSync > CheckNetwork

CheckNetwork > Recovery: "Có sự cố"
Recovery > Step3
CheckNetwork > CheckSubmit: "Bình thường"

CheckSubmit > KeepWorking: "Chưa nộp & Còn giờ"
KeepWorking > Step3
CheckSubmit > Step4: "Hết giờ / Bấm nộp"

Step4 > End
