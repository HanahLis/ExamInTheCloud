// ==============================================================================
// HỆ THỐNG CLOUDEXAM - SƠ ĐỒ KIẾN TRÚC TRIỂN KHAI CHUẨN 3 KHỐI
// Cấu trúc đối chiếu chuẩn: 
// 1. LỚP ỨNG DỤNG & NGHIỆP VỤ (Client & API Gateway)
// 2. AWS CLOUD — DỮ LIỆU, XỬ LÝ NỀN & BẢO MẬT (Singapore ap-southeast-1)
// 3. DỊCH VỤ NGOÀI & ĐA ĐÁM MÂY (Google Gemini, Upstash, Cloudflare, Jakarta DR)
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

// Người dùng hệ thống (Thí sinh / Giảng viên / Admin)
Users [icon: users, label: "Thí sinh / Giảng viên / Admin (VN & Lào)"]

// ------------------------------------------------------------------------------
// KHỐI 1 (TRÊN): LỚP ỨNG DỤNG VÀ NGHIỆP VỤ
// ------------------------------------------------------------------------------
AppLayer [label: "LỚP ỨNG DỤNG VÀ NGHIỆP VỤ", color: blue] {
  ReactWeb [icon: react, label: "React Web SPA\nResponsive • Multi-Country (VN & Lào)"]
  Cognito [icon: aws-cognito, label: "Amazon Cognito\nĐăng nhập • PKCE • Phân quyền"]
  APIGateway [icon: aws-api-gateway, label: "Amazon API Gateway\nREST API • CORS • WAFv2"]
  APIModules [icon: file-text, label: "CÁC MODULE LOGIC REST API:\n• /questions & /question-banks (Đề thi)\n• /candidates & /sessions (Ca thi)\n• /auth/face-verify (Điểm danh AI)\n• /exam/submit (Nộp bài thi bất đồng bộ)"]

  ReactWeb > Cognito: "Đăng nhập / PKCE"
  Cognito > APIGateway: "JWKS Authorizer"
  ReactWeb > APIGateway: "REST / JSON + JWT"
}

// ------------------------------------------------------------------------------
// KHỐI 2 (DƯỚI TRÁI): AWS CLOUD — DỮ LIỆU, XỬ LÝ NỀN VÀ BẢO MẬT (Singapore)
// ------------------------------------------------------------------------------
AWSCloud [label: "AWS CLOUD — DỮ LIỆU, XỬ LÝ NỀN VÀ BẢO MẬT (ap-southeast-1)", color: amber] {
  
  ServerlessAI [label: "Xử lý Serverless & Điểm danh AI", color: orange] {
    LambdaCore [icon: aws-lambda, label: "Lambda Core API\nCRUD Đề, Ca thi, Presigned URL"]
    LambdaFace [icon: aws-lambda, label: "Lambda Face Verify\nDecode ảnh Webcam Base64"]
    Rekognition [icon: aws-rekognition, label: "Amazon Rekognition\nCompareFaces (Khớp >= 80%)"]
  }

  AsyncGrading [label: "Hàng đợi nộp bài & Chấm điểm tự động", color: orange] {
    SQSQueue [icon: aws-sqs, label: "Amazon SQS Queue\nBộ đệm tiếp nhận bài thi"]
    SQSDLQ [icon: aws-sqs, label: "Dead Letter Queue (DLQ)\nLưu bài nộp lỗi (Retry 3x)"]
    GradingWorker [icon: aws-lambda, label: "Lambda Grading Worker\nBatch 10 & Chấm điểm tự động"]
  }

  DatabaseStorage [label: "Cơ sở dữ liệu & Lưu trữ tập trung", color: green] {
    DynamoDB [icon: aws-dynamodb, label: "Amazon DynamoDB (4 Bảng)\nMulti-Tenant (TENANT#VN/LA)"]
    S3Storage [icon: aws-s3, label: "Amazon S3 Media Bucket\nquestions/, faces/, temp/ 24h"]
  }

  PlatformOps [label: "Điều phối ca thi, Giám sát & FinOps", color: purple] {
    StepFunctions [icon: aws-step-functions, label: "AWS Step Functions\nLifecycle ca thi tự động"]
    CloudWatchSNS [icon: aws-cloudwatch, label: "CloudWatch & SNS Alerts\nLog 14 ngày & Cảnh báo"]
    TerraformBudgets [icon: terraform, label: "Terraform & AWS Budgets\nQuản trị IaC & Ngưỡng 0.50$"]
  }
}

// ------------------------------------------------------------------------------
// KHỐI 3 (DƯỚI PHẢI): DỊCH VỤ NGOÀI & ĐA ĐÁM MÂY (MULTI-CLOUD SATELLITES)
// ------------------------------------------------------------------------------
ExternalServices [label: "DỊCH VỤ NGOÀI / ĐA ĐÁM MÂY", color: cyan] {
  GeminiAI [icon: google-cloud, label: "Google Gemini 1.5 Flash\nBóc tách đề Word sang JSON (0$)\nAI Gia sư giải thích câu sai"]
  UpstashRedis [icon: redis, label: "Upstash Serverless Redis\nLive Leaderboard Top 5 (< 5ms)\nBộ nhớ đệm tốc độ cao (0$)"]
  CloudflareTurnstile [icon: cloudflare, label: "Cloudflare Turnstile\nXác thực người thật tàng hình (0.1s)\nChống bot spam nộp bài (0$)"]
  JakartaDR [icon: aws-dynamodb, label: "AWS Jakarta (ap-southeast-3)\nDynamoDB Global Tables (RPO < 1s)\nS3 Cross-Region Repl (CRR)"]
}

// ==============================================================================
// CÁC LUỒNG DỮ LIỆU & QUAN HỆ KẾT NỐI HỆ THỐNG
// ==============================================================================

// 1. Luồng truy cập từ Người dùng
Users > ReactWeb: "HTTPS cloudexam.vn / edulao.la"
ReactWeb > CloudflareTurnstile: "Turnstile Token (0.1s)"

// 2. Luồng gọi API từ Lớp Ứng dụng xuống AWS Cloud
APIGateway > LambdaCore: "REST CRUD Đề & Ca thi"
APIGateway > LambdaFace: "Proxy Webcam Base64"
ReactWeb > S3Storage: "Direct PUT Ảnh (Presigned URL)"

// 3. Xử lý Serverless & Điểm danh khuôn mặt
LambdaFace > Rekognition: "So khớp khuôn mặt"
LambdaFace > S3Storage: "Đọc ảnh thẻ gốc"
LambdaFace > DynamoDB: "Ghi log điểm danh"

// 4. Quản lý đề thi & Tích hợp Google Gemini AI
LambdaCore > DynamoDB: "Lưu Đề thi & Ca thi"
LambdaCore > GeminiAI: "Bóc tách đề Word sang JSON (0$)"

// 5. Hàng đợi nộp bài & Chấm điểm SQS
LambdaCore > SQSQueue: "Enqueue bài nộp (<50ms)"
SQSQueue > GradingWorker: "Batch 10 bài thi"
GradingWorker > SQSDLQ: "Lỗi sau 3 lần retry"
GradingWorker > DynamoDB: "Ghi nhận điểm thi"

// 6. Bảng xếp hạng Live Leaderboard với Upstash Redis
GradingWorker > UpstashRedis: "ZADD cập nhật Leaderboard"
LambdaCore > UpstashRedis: "Query Top 5 (< 5ms)"

// 7. Điều phối ca thi tự động
StepFunctions > DynamoDB: "Status: RUNNING -> CLOSED"

// 8. Đồng bộ Phục hồi thảm họa đa vùng (Multi-Region DR)
DynamoDB > JakartaDR: "Global Tables Sync (RPO < 1s)"
S3Storage > JakartaDR: "S3 Replication (CRR)"

// 8. Đồng bộ Phục hồi thảm họa đa vùng (Multi-Region DR)
DynamoDB > JakartaDR: "Global Tables Sync (RPO < 1s)"
S3Storage > JakartaDR: "S3 Replication (CRR)"

