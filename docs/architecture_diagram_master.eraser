// ==============================================================================
// CLOUDEXAM — HÌNH 2.1: SƠ ĐỒ KIẾN TRÚC TÍNH NĂNG TỔNG THỂ (MASTER FUNCTIONAL ARCHITECTURE)
// Phiên bản chuẩn hóa Report 3 · Cụm 3 Lambda Graviton2 · 5 Bảng DynamoDB · Đầy đủ mã luồng [L-xx]
// Cú pháp: Eraser.io Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

// ------------------------------------------------------------------------------
// CỘT 1: LỚP GIAO DIỆN, THIẾT BỊ NGOẠI VI & BIÊN (CLIENT & EDGE ZONE)
// ------------------------------------------------------------------------------
"1. TRUY CẬP, THIẾT BỊ & BIÊN" [color: blue] {
  Users [icon: users, label: "CloudExam Multi-Country Users\n(Thí sinh · Giảng viên · Giám thị)"]
  WebcamDevice [icon: camera, label: "CloudExam Hardware Webcam\n(HTML5 MediaDevices Peripheral · Mirror Mode)"]
  AntiBotShield [icon: shield, label: "CloudExam Anti-Bot Shield\n(Cloudflare Turnstile < 0.1s)"]
  EdgeRouter [icon: aws-cloudfront, label: "CloudExam Edge Tenant Router\n(CloudFront Functions · Inject x-tenant-id)"]
  ReactApp [icon: react, label: "CloudExam Portal Web Client\n(React 19 SPA · Local-First 0ms · 4 Ngôn ngữ)"]
  AuthServer [icon: aws-cognito, label: "CloudExam Auth Server\n(Amazon Cognito · OAuth 2.0 PKCE / In-App OTP)"]
  APIGateway [icon: aws-api-gateway, label: "CloudExam Central API Gateway\n(Amazon API Gateway REST API · Cognito JWT Authorizer)"]
}

// ------------------------------------------------------------------------------
// CỘT 2: AWS CLOUD — DỮ LIỆU, XỬ LÝ NỀN VÀ AI (SERVERLESS BACKBONE)
// ------------------------------------------------------------------------------
"2. AWS CLOUD — DỮ LIỆU & XỬ LÝ NỀN" [color: amber] {
  "Lưu trữ & Cơ sở dữ liệu dùng chung" {
    AcademicDB [icon: aws-dynamodb, label: "CloudExam Academic Datastore\n(DynamoDB 5 Bảng On-Demand · Sparse GSI)\n• Banks · Questions (BankIdIndex)\n• Candidates (StudentCodeIndex) · Sessions\n• Submissions (Sparse GSI SessionResultsIndex)"]
    MediaBucket [icon: aws-s3, label: "CloudExam Media Storage Bucket\n(Amazon S3 Bucket: questions/ · faces/ · temp-faces/)"]
  }

  "Điểm danh sinh trắc học AI" {
    FaceVault [icon: aws-s3, label: "CloudExam Face Photos Vault\n(Amazon S3 Bucket: faces/ & temp-faces/)"]
    BiometricHandler [icon: aws-lambda, label: "CloudExam Biometric Verify Server\n(AWS Lambda · face_verify_handler.py | 512MB)\nPasscode 6 số · Device Token Mutex Lock"]
    RekognitionAI [icon: aws-rekognition, label: "CloudExam Face Match Engine\n(Amazon Rekognition CompareFaces ≥ 80.0%)"]
  }

  "Đệm tải SQS & Chấm tự động" {
    AppProducer [icon: aws-lambda, label: "CloudExam Ingestion & Core API Server\n(AWS Lambda · api_handler.py | Graviton2 arm64)\nCRUD Học thuật · S3 Presign · SQS Producer"]
    SubmissionQueue [icon: aws-sqs, label: "CloudExam Submission Buffer\n(Amazon SQS Standard Queue · ACK < 50ms)"]
    GradingWorker [icon: aws-lambda, label: "CloudExam Grading Worker Server\n(AWS Lambda · grading_worker.py | Batch 10)"]
    DeadLetterQueue [icon: aws-sqs, label: "CloudExam Submission DLQ\n(Amazon SQS Dead-Letter Queue · Retry > 3)"]
  }

  "Vòng đời ca thi & Báo cáo" {
    ExamStateMachine [icon: aws-step-functions, label: "CloudExam Exam State Machine\n(AWS Step Functions · Wait State $0 Compute)\nAutoFinalizeTask cứu bài nháp rớt mạng"]
    NotificationTopic [icon: aws-sns, label: "CloudExam Notification Topic\n(Amazon SNS Topic · Báo cáo & Cảnh báo)"]
  }

  "Vận hành & Giám sát FinOps" {
    SecretsVault [icon: aws-systems-manager, label: "CloudExam Secrets Store\n(AWS SSM Parameter Store & KMS)"]
    TelemetryEngine [icon: aws-cloudwatch, label: "CloudExam Observability Engine\n(Amazon CloudWatch Logs & AWS Budgets)"]
  }
}

// ------------------------------------------------------------------------------
// CỘT 3: DỊCH VỤ NGOÀI MULTI-CLOUD (0 USD SATELLITES)
// ------------------------------------------------------------------------------
"3. DỊCH VỤ NGOÀI MULTI-CLOUD" [color: purple] {
  GenAIEngine [icon: google-cloud, label: "CloudExam AI Document Parser\n(Google Gemini 1.5 Flash API · Structured JSON)\nFallback sang Regex NLP Engine (0.05s)"]
  LiveCache [icon: redis, label: "CloudExam Live Leaderboard Engine\n(Upstash Serverless Redis · Sorted Set ZADD < 5ms)"]
}

// ==============================================================================
// GIAO THỨC TRUYỀN THÔNG & ĐIỀU HƯỚNG TỰ NHIÊN (LEFT -> CENTER -> RIGHT)
// ==============================================================================

// 1. Phân giải tên miền & Truy cập đa quốc gia (Tính năng 9 & 10)
Users > EdgeRouter: "[L-01a] HTTPS DNS: cloudexam.id.vn (vn, lao, de, us)"
EdgeRouter > ReactApp: "[L-02b] Edge Inject Header: x-tenant-id (vn/la/de/default)"

// 2. Định danh & Cổng API trung tâm (Tính năng 1)
ReactApp <> AuthServer: "[L-03] HTTPS POST (OAuth 2.0 PKCE / In-App Signup OTP)"
ReactApp > APIGateway: "[L-04] HTTPS REST (Port 443 + Bearer JWT Token)"
APIGateway > AppProducer: "[L-05] AWS Lambda Proxy Integration (SigV4)"

// 3. Quản trị đề thi & Số hóa AI (Tính năng 2 & 3)
AppProducer > MediaBucket: "[L-06] AWS SDK Boto3 (SigV4) - Action: s3:generate_presigned_url (questions/ TTL 300s)"
ReactApp > MediaBucket: "[L-07] Direct HTTPS PUT ảnh câu hỏi (0MB qua backend)"
AppProducer > SecretsVault: "[L-08] AWS SDK Boto3 (SigV4) - Action: ssm:GetParameter (/cloudexam/gemini/api_key)"
AppProducer > GenAIEngine: "[L-09] REST over HTTPS (POST Gemini 1.5 Flash / Structured JSON Schema)"
GenAIEngine > AppProducer: "[L-10] HTTPS Response 200 (JSON MCQs) hoặc Regex NLP Fallback (0.05s)"
AppProducer > AcademicDB: "[L-11b] AWS SDK Boto3 (SigV4) - Action: dynamodb:BatchWriteItem (CloudExam_Questions_dev)"
AppProducer > AcademicDB: "[L-11d] AWS SDK Boto3 (SigV4) - Action: dynamodb:PutItem (Ca thi mới & Passcode 6 số)"
AppProducer > ExamStateMachine: "[L-11e] AWS SDK Boto3 (SigV4) - Action: states:StartExecution (Khởi chạy State Machine)"

// 4. Điểm danh sinh trắc học AI có Webcam & Khóa máy (Tính năng 4 & 5)
Users > WebcamDevice: "Căn chỉnh mặt trước camera (Mirror Mode)"
WebcamDevice > ReactApp: "[L-12] HTML5 navigator.mediaDevices (Blob nhị phân ~150KB)"
ReactApp > FaceVault: "[L-13a] Direct HTTPS PUT Blob lên S3 temp-faces/ (TTL 60s, 0MB qua backend)"
ReactApp > APIGateway: "[L-13d] HTTPS POST /auth/face-verify (sessionId, studentCode, deviceToken, passcode)"
APIGateway > BiometricHandler: "[L-05d] AWS Lambda Proxy Integration (SigV4)"
FaceVault > BiometricHandler: "[L-14] AWS SDK Boto3 (SigV4) - Action: s3:GetObject (Đọc ảnh thẻ gốc faces/ và ảnh tạm temp-faces/)"
BiometricHandler > RekognitionAI: "[L-15] AWS SDK Boto3 (SigV4) - Action: rekognition:CompareFaces (SimilarityThreshold ≥ 80.0%)"
BiometricHandler > AcademicDB: "[L-16] AWS SDK Boto3 (SigV4) - UpdateItem (status: CHECKED_IN & Ghi khóa lockedCandidates)"
BiometricHandler > NotificationTopic: "[L-17] AWS SDK Boto3 (SigV4) - Action: sns:Publish (Cảnh báo gian lận tới Giám thị)"

// 5. Nộp bài đệm tải SQS & Chấm theo lô & Leaderboard (Tính năng 6, 7 & 8)
ReactApp > AcademicDB: "[L-18b] Throttled Sync POST /save-progress (Gom 10 câu lưu nháp)"
ReactApp > AntiBotShield: "HTTPS GET (Request Turnstile Token < 0.1s)"
AntiBotShield > ReactApp: "cf-turnstile-response Token String"
ReactApp > APIGateway: "[L-18c] HTTPS POST (application/json) /exam/submit (Answers + Turnstile Token)"
AppProducer > SubmissionQueue: "[L-19] AWS SDK Boto3 (SigV4) - Action: sqs:SendMessage (ACK < 50ms)"
SubmissionQueue > GradingWorker: "[L-20] AWS SQS-to-Lambda Event Source Mapping (BatchSize = 10, Window = 2s)"
GradingWorker > AcademicDB: "[L-21a] AWS SDK Boto3 (SigV4) - Action: dynamodb:BatchGetItem (Lấy toàn bộ đáp án chuẩn 1 lần)"
GradingWorker > AcademicDB: "[L-21b] AWS SDK Boto3 (SigV4) - Action: dynamodb:UpdateItem (Ghi điểm & status: COMPLETED)"
GradingWorker > LiveCache: "[L-21c] HTTPS REST ZADD (Upstash Redis Live Leaderboard < 5ms)"
GradingWorker > DeadLetterQueue: "[L-22] SQS Redrive Policy (maxReceiveCount = 3 chuyển DLQ)"

// 6. Điều phối vòng đời ca thi, Auto-Finalize & Báo cáo (Tính năng 9)
ExamStateMachine > AcademicDB: "[L-23] Direct SDK Task - Action: dynamodb:updateItem (Wait State: SCHEDULED -> RUNNING -> CLOSED)"
ExamStateMachine > AppProducer: "Direct Lambda Task - Action: AutoFinalize (Quét bài nháp thí sinh rớt mạng chấm bù)"
ExamStateMachine > NotificationTopic: "[L-24] Direct SDK Task - Action: sns:publish (Email bảng điểm tổng kết)"
DeadLetterQueue > TelemetryEngine: "[L-25] CloudWatch Metric Alarm (MessagesVisible > 0)"
