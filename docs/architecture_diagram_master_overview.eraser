// ==============================================================================
// HỆ THỐNG CLOUDEXAM - SƠ ĐỒ KIẾN TRÚC TỔNG QUÁT (MASTER ARCHITECTURE OVERVIEW)
// Mô hình Hạt nhân & Vệ tinh (Hub-and-Spoke Multi-Cloud), Đa vùng DR & FinOps 0$
// Cú pháp: Eraser Diagram-as-Code (https://app.eraser.io)
// ==============================================================================

direction right

// ------------------------------------------------------------------------------
// 1. NGƯỜI DÙNG & TÊN MIỀN QUỐC GIA
// ------------------------------------------------------------------------------
Users [icon: users, label: "Người Dùng Đa Quốc Gia\n• Việt Nam: cloudexam.vn\n• Lào: edulao.la"]

// ------------------------------------------------------------------------------
// 2. BẢO MẬT BIÊN & PHÂN PHỐI CDN (EDGE LAYER)
// ------------------------------------------------------------------------------
EdgeTier [label: "BẢO MẬT BIÊN & CDN TOÀN CẦU", color: blue] {
  Cloudflare [icon: cloudflare, label: "Cloudflare Turnstile\nChống Bot tàng hình (0.1s)"]
  Route53 [icon: aws-route-53, label: "Amazon Route 53\nDNS Geolocation & Failover"]
  CloudFrontWAF [icon: aws-cloudfront, label: "CloudFront CDN & AWS WAFv2\nTenant Resolver x-tenant-id"]
}

// ------------------------------------------------------------------------------
// 3. GIAO DIỆN & XÁC THỰC (APP & AUTH)
// ------------------------------------------------------------------------------
AppTier [label: "GIAO DIỆN & CỔNG TRUY CẬP", color: cyan] {
  ReactSPA [icon: react, label: "React 18 SPA\nDynamic Multi-Country UI"]
  Cognito [icon: aws-cognito, label: "Amazon Cognito\nPKCE Auth • RBAC Groups"]
  APIGateway [icon: aws-api-gateway, label: "Amazon API Gateway\nREST API • Cognito Authorizer"]
}

// ------------------------------------------------------------------------------
// 4. TRUNG TÂM XỬ LÝ & LƯU TRỮ (AWS SINGAPORE - PRIMARY)
// ------------------------------------------------------------------------------
AWSCore [label: "AWS PRIMARY REGION (Singapore ap-southeast-1)", color: amber] {
  LambdaHub [icon: aws-lambda, label: "AWS Lambda Serverless Hub\nCore API • Face Verify • Grading Worker"]
  Rekognition [icon: aws-rekognition, label: "Amazon Rekognition\nAI Vision đối sánh ảnh >= 80%"]
  SQSBuffer [icon: aws-sqs, label: "Amazon SQS & DLQ\nBộ đệm bài thi & Chống nghẽn"]
  DynamoDBPrimary [icon: aws-dynamodb, label: "Amazon DynamoDB (4 Bảng)\nMulti-Tenant TENANT#VN/LA"]
  S3Primary [icon: aws-s3, label: "Amazon S3 Media Storage\nẢnh thẻ faces/ & Ảnh đề questions/"]
  StepFunctions [icon: aws-step-functions, label: "AWS Step Functions\nĐiều phối chu kỳ ca thi tự động"]
}

// ------------------------------------------------------------------------------
// 5. VỆ TINH ĐA ĐÁM MÂY (MULTI-CLOUD SATELLITES)
// ------------------------------------------------------------------------------
Satellites [label: "VỆ TINH ĐA ĐÁM MÂY (MULTI-CLOUD)", color: orange] {
  GoogleGemini [icon: google-cloud, label: "Google Gemini 1.5 Flash AI\nBóc tách file Word đề thi (0$)\nAI Gia sư giải thích câu sai"]
  UpstashRedis [icon: redis, label: "Upstash Serverless Redis\nLive Leaderboard Top 5 (< 5ms)\nBộ nhớ đệm tốc độ cao (0$)"]
}

// ------------------------------------------------------------------------------
// 6. PHỤC HỒI THẢM HỌA ĐA VÙNG (JAKARTA DR - STANDBY)
// ------------------------------------------------------------------------------
DRRegion [label: "AWS DR REGION (Jakarta ap-southeast-3)", color: green] {
  DynamoDBReplica [icon: aws-dynamodb, label: "DynamoDB Global Tables\nĐồng bộ 2 chiều (RPO < 1s)"]
  S3Replica [icon: aws-s3, label: "S3 Cross-Region Replica\nNhân bản ảnh chéo vùng (CRR)"]
}

// ------------------------------------------------------------------------------
// 7. QUẢN TRỊ DEVOPS & FINOPS 0$ (GOVERNANCE)
// ------------------------------------------------------------------------------
FinOpsOps [label: "QUẢN TRỊ IAC, GIÁM SÁT & FINOPS (0$)", color: purple] {
  Terraform [icon: terraform, label: "HashiCorp Terraform (IaC)\nTự động hóa 100% 14 modules"]
  CloudWatchSNS [icon: aws-cloudwatch, label: "CloudWatch & SNS Alerts\nLog retention 14 ngày & 4 Alarms"]
  Budgets [icon: aws-cloudwatch, label: "AWS Budgets (Ngưỡng 0.50$)\nHàng rào bảo vệ chi phí 0 USD"]
}

// ==============================================================================
// CÁC LUỒNG KẾT NỐI CHÍNH CỦA HỆ THỐNG
// ==============================================================================

// 1. Luồng truy cập và biên
Users > EdgeTier: "1. HTTPS cloudexam.vn / edulao.la"
EdgeTier > AppTier: "2. Chuyển tiếp x-tenant-id & Web Assets"
ReactSPA > Cognito: "3. Đăng nhập PKCE (Cấp Bearer JWT)"
ReactSPA > APIGateway: "4. Gọi REST API (Bearer JWT)"

// 2. Luồng xử lý trong AWS Singapore
APIGateway > LambdaHub: "5. Kích hoạt Serverless Compute"
LambdaHub > Rekognition: "6. Điểm danh AI khuôn mặt"
LambdaHub > SQSBuffer: "7. Đệm bài thi nộp bất đồng bộ"
LambdaHub > DynamoDBPrimary: "8. Lưu Đề, Ca thi & Điểm số"
ReactSPA > S3Primary: "9. Direct PUT ảnh (Presigned URL)"
StepFunctions > DynamoDBPrimary: "10. Quản lý trạng thái ca thi"

// 3. Luồng kết nối Vệ tinh Đa đám mây
LambdaHub > Satellites: "11. Bóc tách đề Word (Gemini) & Live Leaderboard (Upstash)"

// 4. Luồng Phục hồi thảm họa đa vùng (DR)
DynamoDBPrimary <> DynamoDBReplica: "12. Global Tables Sync 2 chiều (RPO < 1s)"
S3Primary > S3Replica: "13. S3 Cross-Region Replication (CRR)"
Route53 --> DRRegion: "14. DNS Failover tự động khi có sự có (RTO < 2m)"

// 5. Quản trị & Giám sát FinOps
Terraform > AWSCore: "15. Provision Least-Privilege"
AWSCore > FinOpsOps: "16. Logs, Alarms & Cảnh báo chi phí 0.50$"

