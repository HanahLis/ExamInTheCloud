# ==============================================================================
# CLOUDEXAM FRONTEND ENVIRONMENT CONFIGURATION (.env)
# Sao chép tệp này thành .env (hoặc .env.local):
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# Chế độ Mock ngoại tuyến (true: chạy giả lập không cần AWS; false: kết nối AWS thật)
VITE_USE_MOCK=false

# AWS Region triển khai dự án (khớp với aws_region trong backend/terraform/terraform.tfvars)
VITE_AWS_REGION=ap-southeast-1

# URL API Gateway REST API (lấy từ output 'api_gateway_base_url' của Terraform)
# Ví dụ: https://xxxxxxxxx.execute-api.ap-southeast-1.amazonaws.com/dev
VITE_API_BASE_URL=https://<API_ID>.execute-api.ap-southeast-1.amazonaws.com/dev

# Tên miền AWS Cognito Hosted UI (lấy từ output 'cognito_domain' của Terraform)
# Ví dụ: https://cloudexam-auth-<YOUR_AWS_ACCOUNT_ID>-dev.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=https://<COGNITO_DOMAIN_PREFIX>.auth.ap-southeast-1.amazoncognito.com

# ID của Cognito User Pool (lấy từ output 'cognito_user_pool_id' của Terraform)
# Ví dụ: ap-southeast-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_ID=<COGNITO_USER_POOL_ID>

# Client ID của Cognito App Client SPA (lấy từ output 'cognito_app_client_id' của Terraform)
# Ví dụ: 2kmj6t3bri0obt8qhf33korqep
VITE_COGNITO_CLIENT_ID=<COGNITO_APP_CLIENT_ID>

# URL Callback sau khi đăng nhập qua Hosted UI (khớp với frontend_callback_urls trong Terraform)
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback

# Cognito Identity Pool ID dùng cho upload ảnh S3 trực tiếp (lấy từ output 'cognito_identity_pool_id')
# Ví dụ: ap-southeast-1:75a2141b-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_IDENTITY_POOL_ID=<COGNITO_IDENTITY_POOL_ID>

# Tên S3 Bucket lưu trữ ảnh thẻ và sơ đồ (lấy từ output 's3_bucket_name' của Terraform)
# Ví dụ: cloudexam-storage-<YOUR_AWS_ACCOUNT_ID>-dev
VITE_S3_BUCKET_NAME=<S3_BUCKET_NAME>

